----------------------------------------SYMBOL TABLE---------------------------
#include <stdio.h>
#include <string.h>

struct symbol {
    char name[20];
    char type[20];
    int address;
};

int main() {
    struct symbol s[10];
    int n = 0, choice, i;
    char search[20];

    while (1) {
        printf("\n--- Symbol Table ---\n");
        printf("1. Insert\n");
        printf("2. Display\n");
        printf("3. Search\n");
        printf("4. Exit\n");

        printf("Enter choice: ");
        scanf("%d", &choice);

        switch (choice) {

            case 1:
                if (n >= 10) {
                    printf("Symbol Table is full!\n");
                    break;
                }

                printf("Enter name: ");
                scanf("%19s", s[n].name);

                printf("Enter type: ");
                scanf("%19s", s[n].type);

                printf("Enter address: ");
                scanf("%d", &s[n].address);

                n++;
                printf("Symbol inserted successfully.\n");
                break;

            case 2:
                if (n == 0) {
                    printf("Symbol Table is empty.\n");
                } else {
                    printf("\nName\tType\tAddress\n");

                    for (i = 0; i < n; i++) {
                        printf("%s\t%s\t%d\n",
                               s[i].name,
                               s[i].type,
                               s[i].address);
                    }
                }
                break;

            case 3:
                printf("Enter name to search: ");
                scanf("%19s", search);

                for (i = 0; i < n; i++) {
                    if (strcmp(search, s[i].name) == 0) {
                        printf("Found: %s\t%s\t%d\n",
                               s[i].name,
                               s[i].type,
                               s[i].address);
                        break;
                    }
                }

                if (i == n) {
                    printf("Symbol not found.\n");
                }
                break;

            case 4:
                printf("Exiting...\n");
                return 0;

            default:
                printf("Enter a valid choice.\n");
        }
    }

    return 0;
}


----------------------------------------------------------------------------------LEXICAL ANALYZER-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char s[500], w[50];
    char keywords[][10] = {
        "int", "float", "char", "double",
        "if", "else", "while", "for",
        "do", "return", "void", "break"
    };

    int i = 0, j, k, flag;

    printf("Enter code: ");
    fgets(s, sizeof(s), stdin);

    while (s[i] != '\0') {

        if (isspace(s[i])) {
            i++;
        }

        else if (isalpha(s[i]) || s[i] == '_') {
            j = 0;

            while (isalnum(s[i]) || s[i] == '_')
                w[j++] = s[i++];

            w[j] = '\0';
            flag = 0;

            for (k = 0; k < 12; k++)
                if (strcmp(w, keywords[k]) == 0)
                    flag = 1;

            printf("%s -> %s\n", w,
                   flag ? "Keyword" : "Identifier");
        }

        else if (isdigit(s[i])) {
            j = 0;

            while (isdigit(s[i]) || s[i] == '.')
                w[j++] = s[i++];

            w[j] = '\0';
            printf("%s -> Constant\n", w);
        }

        else if (s[i] == '/' && s[i+1] == '/') {
            printf("Comment\n");
            break;
        }

        else if (s[i] == '/' && s[i+1] == '*') {
            printf("Comment\n");
            i += 2;

            while (s[i] && !(s[i] == '*' && s[i+1] == '/'))
                i++;

            if (s[i]) i += 2;
        }

        else if (strchr("+-*/%=<>!&|^", s[i])) {
            if (strchr("=!<>", s[i]) && s[i+1] == '=' ||
                (s[i] == s[i+1] &&
                strchr("+-&|", s[i]))) {
                printf("%c%c -> Operator\n", s[i], s[i+1]);
                i += 2;
            }
            else
                printf("%c -> Operator\n", s[i++]);
        }

        else if (strchr(";,(){}[].:#", s[i]))
            printf("%c -> Special Symbol\n", s[i++]);

        else
            i++;
    }

    return 0;
}
