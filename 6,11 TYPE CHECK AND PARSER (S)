#---------------------TYPE CHECK---------------

#include <stdio.h>
#include <string.h>

int main() {
    char type1[10], type2[10], op;

    printf("Enter first type (int/float): ");
    scanf("%9s", type1);

    printf("Enter operator (+,-,*,/): ");
    scanf(" %c", &op);

    printf("Enter second type (int/float): ");
    scanf("%9s", type2);

    if (strcmp(type1, "int") == 0 &&
        strcmp(type2, "int") == 0)
        printf("Type checking successful\n");

    else if ((strcmp(type1, "int") == 0 ||
              strcmp(type1, "float") == 0) &&
             (strcmp(type2, "int") == 0 ||
              strcmp(type2, "float") == 0))
        printf("Type checking successful\n");

    else
        printf("Type Error\n");

    return 0;
}

#---------------------------------PARSER-----------------

#include <stdio.h>

char s[50];
int i = 0, error = 0;

void S();
void L();

void S() {
    if (s[i] == 'a')
        i++;

    else if (s[i] == '(') {
        i++;
        L();

        if (s[i] == ')')
            i++;
        else
            error = 1;
    }

    else
        error = 1;
}

void L() {
    S();

    while (s[i] == ',') {
        i++;
        S();
    }
}

int main() {
    printf("Enter string: ");
    scanf("%49s", s);

    S();

    if (!error && s[i] == '\0')
        printf("Valid String\n");
    else
        printf("Invalid String\n");

    return 0;
}

