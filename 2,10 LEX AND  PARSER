void F();

void E() {
    T();
    while (s[i] == '+') {
        i++;
        T();
    }
}

void T() {
    F();
    while (s[i] == '*') {
        i++;
        F();
    }
}

void F() {
    if (strncmp(s+i, "id", 2) == 0)
        i += 2;

    else if (s[i] == '(') {
        i++;
        E();

        if (s[i] == ')')
            i++;
        else
            error = 1;
    }
    else
        error = 1;
}

